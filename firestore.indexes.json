{
  "//": "Composite indexes ที่ query ในแอปต้องใช้ — Firestore บังคับให้ประกาศไว้ล่วงหน้า",
  "//2": "สร้างจาก error 'The query requires an index' ที่ Firebase Console แสดง หรือรัน firebase deploy --only firestore:indexes",
  "indexes": [
    {
      "//": "หน้าแรก (สำรวจ): กรองตามหมวดหมู่ แล้วเรียงล่าสุด",
      "collectionGroup": "products",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "categoryId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "หน้าแรก (สำรวจ): กรองตามภาค แล้วเรียงล่าสุด",
      "collectionGroup": "products",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "region", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "หน้าแรก (สำรวจ): กรองทั้งหมวดหมู่และภาค แล้วเรียงล่าสุด",
      "collectionGroup": "products",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "categoryId", "order": "ASCENDING" },
        { "fieldPath": "region", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "สินค้าในร้าน (หน้าร้านของผู้ขาย) เรียงล่าสุด",
      "collectionGroup": "products",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "storeId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "ออเดอร์ของร้าน (ผู้ขายดู) — กรองสถานะแล้วเรียงล่าสุด",
      "collectionGroup": "orders",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "storeId", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "รายการรีวิวของสินค้า เรียงล่าสุด",
      "collectionGroup": "reviews",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "productId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "ประวัติออเดอร์ของลูกค้า เรียงล่าสุด",
      "collectionGroup": "orders",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "buyerUid", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "แชทของผู้ใช้ เรียงตามข้อความล่าสุด",
      "collectionGroup": "chat_threads",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "participantUids", "arrayConfig": "CONTAINS" },
        { "fieldPath": "lastAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "คูปองของร้าน เฉพาะที่ยังใช้ได้",
      "collectionGroup": "coupons",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "storeId", "order": "ASCENDING" },
        { "fieldPath": "active", "order": "ASCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
