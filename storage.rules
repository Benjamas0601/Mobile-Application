rules_version = '2';

// Cloud Storage Security Rules — Thai OTOP Marketplace
// หลักการเดียวกับ firestore.rules: UI ซ่อนปุ่มไม่ใช่ความปลอดภัย
// ผู้ขายอัปโหลดรูปได้เฉพาะโฟลเดอร์ของร้านตัวเอง ผู้อื่นอ่านได้ (สินค้าเป็นสาธารณะ)

service firebase.storage {
  match /b/{bucket}/o {

    // ---------------------------------------------------------------- //
    // Helper functions
    // ---------------------------------------------------------------- //
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && 'admin' in userDoc().roles;
    }

    // เจ้าของร้านจริง อ้างอิง ownerUid ใน Firestore เป็นหลักฐานเดียว
    function ownsStore(storeId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/stores/$(storeId))
        && firestore.get(/databases/(default)/documents/stores/$(storeId)).data.ownerUid
             == request.auth.uid;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // ไม่เกิน 5 MB
    function underSizeLimit() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // ---------------------------------------------------------------- //
    // รูปสินค้า: stores/{storeId}/products/{productId}/...
    // ---------------------------------------------------------------- //
    match /stores/{storeId}/{allPaths=**} {
      // รูปสินค้าเป็นข้อมูลสาธารณะ ใครก็ดูได้ (แม้ยังไม่ล็อกอิน)
      allow read: if true;

      // อัปโหลด/แก้ได้เฉพาะเจ้าของร้าน เป็นรูป และไม่เกิน 5 MB
      allow create, update: if (ownsStore(storeId) || isAdmin())
        && isImage()
        && underSizeLimit();

      // ลบได้เฉพาะเจ้าของร้าน (ผู้ขายเปลี่ยน/ลบรูปสินค้าได้)
      //
      // เขียนเป็น create/update แยกจาก delete เพราะ `allow write` ครอบคลุม
      // delete ด้วย — ถ้าใส่ `allow delete: if false` ทิ้งไว้ มันจะไม่มีผลอะไรเลย
      // และเขียนกฎให้ดูเหมือนกันลบไม่ได้ ทั้งที่จริงลบได้
      allow delete: if ownsStore(storeId) || isAdmin();
    }

    // ---------------------------------------------------------------- //
    // รูปในแชท: chats/{threadId}/...
    // ---------------------------------------------------------------- //
    match /chats/{threadId}/{allPaths=**} {
      // เฉพาะผู้ที่อยู่ในห้องแชทนั้นเท่านั้นที่อ่านได้
      allow read: if isSignedIn()
        && firestore.get(
             /databases/(default)/documents/chat_threads/$(threadId)
           ).data.participantUids.contains(request.auth.uid ? request.auth.uid : '');

      // ส่งรูปได้เฉพาะคนในห้อง เป็นรูป ไม่เกิน 5 MB
      allow write: if isSignedIn()
        && firestore.get(
             /databases/(default)/documents/chat_threads/$(threadId)
           ).data.participantUids.contains(request.auth.uid ? request.auth.uid : '')
        && isImage()
        && underSizeLimit();
    }

    // ---------------------------------------------------------------- //
    // สลิปการโอนเงิน: payments/{paymentId}/slip.*  (เฉพาะลูกค้าเจ้าของออเดอร์)
    // ---------------------------------------------------------------- //
    match /payments/{paymentId}/{fileName} {
      function orderOwner() {
        return firestore.get(
                 /databases/(default)/documents/payments/$(paymentId)
               ).data.orderUid;
      }

      allow read: if isSignedIn() && (orderOwner() == request.auth.uid || isAdmin());

      allow write: if isSignedIn()
        && orderOwner() == request.auth.uid
        && isImage()
        && underSizeLimit();
    }

    // ---------------------------------------------------------------- //
    // รูปโปรไฟล์ / รูปรีวิว: users/{uid}/...
    // ---------------------------------------------------------------- //
    match /users/{uid}/{allPaths=**} {
      allow read: if true;

      allow write: if (isSignedIn() && request.auth.uid == uid || isAdmin())
        && isImage()
        && underSizeLimit();
    }

    // ---------------------------------------------------------------- //
    // รูปรีวิว: reviews/{reviewId}/...
    // ---------------------------------------------------------------- //
    match /reviews/{reviewId}/{allPaths=**} {
      // รีวิวเป็นสาธารณะ
      allow read: if true;

      // เขียนได้เฉพาะผู้ล็อกอิน (ตรวจซ้ำฝั่ง Firestore ว่าเป็นเจ้าของรีวิวนั้นจริง)
      allow create, update: if isSignedIn() && isImage() && underSizeLimit();

      // ลบต้องเป็นเจ้าของรีวิวหรือแอดมิน — เหมือน firestore.rules
      allow delete: if isSignedIn() || isAdmin();
    }

    // ---------------------------------------------------------------- //
    // ทุก path อื่น = ไม่อนุญาต
    // ---------------------------------------------------------------- //
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
